{
  "name": "thapar-journey-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node --watch server/index.js\" \"vite\"",
    "server": "node --watch server/index.js",
    "client": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/**/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.55.0",
    "mongoose": "^9.11.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^10.1.4",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "pptxgenjs": "^4.0.1",
    "supertest": "^7.0.0",
    "vite": "^8.3.0"
  }
