# ==============================================================================
# Thapar Journey Connect - Environment Variables Configuration
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Pure MongoDB Atlas Cloud - No SQLite)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/thapar_journey?retryWrites=true&w=majority

# JWT Session Authentication Secret (Must be >= 32 characters in production)
SESSION_SECRET=thapar_journey_connect_super_secret_jwt_key_at_least_32_chars_long

# Official Google Identity Services OAuth 2.0 Client ID (Required for @thapar.edu verification)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Add Authorized JavaScript Origins: http://localhost:5173, https://your-app.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend App Origin (Strict CORS and Socket.io origin validation)
APP_ORIGIN=http://localhost:5173
